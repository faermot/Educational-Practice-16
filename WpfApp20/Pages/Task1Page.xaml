<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="WpfApp20.Pages.Task1Page"
    Title="Task1Page"
    av:DesignHeight="370" 
    av:DesignWidth="600">

    <Grid Margin="10,10,10,10">
        
        
        <TextBlock x:Name="TaskNumberTextBlock"
                   Text="Задание №1"
                   FontSize="23" 
                   FontWeight="Bold" 
                   Margin="10,8,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" 
                   Width="184"/>
        
        

        <!-- Поля для ввода данных -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Width="544" HorizontalAlignment="Center" Margin="0,68,0,96">
            <StackPanel x:Name="InputFieldsContainer" Margin="10">
                <TextBlock>
                    Дан файл f, компоненты которого являются действительными числами. <LineBreak/>
                    Найти произведение компонентов файла.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка расчёта -->
        <Button Content="Выбрать файл и рассчитать"
                HorizontalAlignment="Center"
                Margin="0,300,0,10" 
                Padding="10" 
                Width="560"
                Height="40"
                Click="CalculateButton_Click" />

        <!-- Поле для вывода результата -->
        <TextBlock x:Name="ResultTextBlock" 
                   VerticalAlignment="Center"
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="Green" Margin="10,246,10,50" />
    </Grid>
</Page>
